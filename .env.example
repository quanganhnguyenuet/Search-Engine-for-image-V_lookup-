# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web server -> FastAPI (for host development also set this in apps/web/.env.local)
SEARCH_API_URL=http://127.0.0.1:8000

# Portable SigLIP2 export imported from Kaggle; paths relative to repo root
EMBEDDING_ARTIFACT_DIR=data/embeddings/culture-siglip2
EMBEDDING_CACHE_DIR=data/models/huggingface
EMBEDDING_DEVICE=cpu
EMBEDDING_CPU_THREADS=4

# Ollama runs locally; no API key required for a local server
OLLAMA_URL=http://127.0.0.1:11434
RAG_MODEL=qwen2.5:3b
RAG_MIN_SCORE=0.10
RAG_TIMEOUT_SECONDS=120

# PostgreSQL
POSTGRES_DB=visualseek
POSTGRES_USER=visualseek
POSTGRES_PASSWORD=visualseek
DATABASE_URL=postgresql+asyncpg://visualseek:visualseek@postgres:5432/visualseek

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Cloudflare R2 / S3-compatible local development
R2_ENDPOINT_URL=http://object-storage:9000
R2_ACCESS_KEY_ID=visualseek
R2_SECRET_ACCESS_KEY=visualseek-local-secret
R2_BUCKET_NAME=visualseek-images
R2_REGION=auto
MINIO_ROOT_USER=visualseek
MINIO_ROOT_PASSWORD=visualseek-local-secret

